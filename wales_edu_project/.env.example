
# Application environment:
# CLOUD connects to Neo4j Aura.
# LOCAL connects to a Neo4j Desktop database.
APP_MODE=LOCAL


# Neo4j Aura configuration
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=


# Gemini configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.6-flash


# Local Neo4j configuration
LOCAL_NEO4J_URI=neo4j://127.0.0.1:7687
LOCAL_NEO4J_USER=neo4j
LOCAL_NEO4J_PASSWORD=
LOCAL_NEO4J_DATABASE=education-inequality-project
